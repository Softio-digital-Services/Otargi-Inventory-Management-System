+/* Settings Layout */
+.settings-layout {
+  display: flex;
+  flex-direction: column;
+  gap: 1.25rem;
+}
+.settings-grid-row {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 1.25rem;
+  align-items: stretch;
+}
+.settings-grid-row:has(> [hidden]:first-child:last-child),
+.settings-grid-row:empty {
+  display: none;
+}
+@media (max-width: 768px) {
+  .settings-grid-row {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* Global Empty State Styling */
+.empty-state {
+  grid-column: 1 / -1;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: 3rem 1rem;
+  color: var(--text-muted);
+  font-size: 0.95rem;
+  text-align: center;
+  width: 100%;
+}
+.empty-state .material-symbols-rounded {
+  font-size: 3.5rem;
+  opacity: 0.45;
+  margin-bottom: 0.5rem;
+}
+
+/* POS Customer Box: remove grey background shape when debt is hidden or empty */
+.pos-customer-debt[hidden],
+.pos-customer-debt:empty {
+  display: none !important;
+  margin: 0 !important;
+  padding: 0 !important;
+  border: none !important;
+}
+
+/* Arabic (RTL): position header window controls on the left side and invert button order (X [] _) so Close is at far left edge */
+body.rtl #titlebar,
+body.rtl .titlebar {
+  flex-direction: row-reverse !important;
+}
+body.rtl .window-controls {
+  flex-direction: row-reverse !important;
+}
+body.rtl #titlebar-tools {
+  margin-inline-start: 8px;
+  margin-inline-end: 8px;
+}
+
+/* Settings Page Alignment (Header text at start, action buttons at end) */
+.settings-page-header {
+  width: 100%;
+  text-align: start;
+}
+.settings-page-header > div {
+  text-align: start;
+}
+.settings-card-footer {
+  display: flex;
+  justify-content: flex-end;
+  margin-top: 1rem;
+}
+.settings-save-bar {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 1rem;
+  margin-top: 1.25rem;
+  padding-top: 1rem;
+  border-top: 1px solid var(--border-color);
+}
+
+/* Mandatory License Wall Blocking rules */
+#license-modal.license-wall-blocking {
+  z-index: 999999 !important;
+  pointer-events: auto !important;
+}
+
+#license-modal.license-wall-blocking .close-btn {
+  display: none !important;
+}
+
